# Generate privately with: npm run password:hash
# Paste the complete output hash below; never put the original password here.
OWNER_PASSWORD_HASH=

# Production values belong in Render's Environment settings, not this file.
# render.yaml sets NODE_ENV=production, HOST=0.0.0.0 and an absolute data path.
# Render supplies PORT and RENDER_EXTERNAL_URL; PUBLIC_ORIGIN can stay unset.
# For a custom domain, set PUBLIC_ORIGIN to its exact HTTPS origin (no path).
