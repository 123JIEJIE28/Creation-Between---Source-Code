# Local login preview: copy this file to .env, fill in the password hash,
# then run: npm run start:configured
# npm start does not automatically load .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
LIBRARY_DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:4173
